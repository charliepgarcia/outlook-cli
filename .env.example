# outlook-cli credentials.
# Copy to .env and fill in. See SETUP.md for how to obtain GRAPH_CLIENT_ID.
# NEVER commit .env — it is gitignored.

# REQUIRED. Application (client) ID from your Azure app registration.
# SETUP.md walks the 5-click registration. Public client — this is NOT a secret,
# but it is per-install, so there is no default.
GRAPH_CLIENT_ID=

# OPTIONAL. Which account types may sign in. Default: common
#   common        -> personal Microsoft accounts AND work/school accounts  (recommended)
#   organizations -> work/school only
#   consumers     -> personal only
#   <tenant GUID> -> a single specific tenant
GRAPH_TENANT_ID=common

# OPTIONAL. Only for confidential-client mode. Leave BLANK for the default
# device-code public-client flow, which needs no secret.
GRAPH_CLIENT_SECRET=

# OPTIONAL. Override the token cache location.
# Default: ~/.afk/state/outlook/token.json  (created chmod 0600)
GRAPH_TOKEN_CACHE=

# OPTIONAL. Email signature, appended to send/draft create/reply/forward.
# Graph never applies your Outlook signature itself. Skip per message with
# --no-signature. The HTML file is used for --html bodies.
OUTLOOK_SIGNATURE_FILE=
OUTLOOK_SIGNATURE_HTML_FILE=
